# ==============================================================================
# Banking Analytics Portal - Environment Configuration Template
# Copy this file to .env before starting the stack.
# NEVER commit your .env file containing real secrets to version control.
# ==============================================================================

# Application Database (Dedicated PostgreSQL instance)
# Note: Host port is mapped to 5433 to avoid conflict with any existing local PostgreSQL
PORTAL_DB_PORT=5433
POSTGRES_DB=banking_portal_db
POSTGRES_USER=postgres
# INSTRUCTIONS: Generate your own secure database password before running the stack.
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_OWN_SECURE_POSTGRES_PASSWORD_PLACEHOLDER

# Backend Security & Cryptographic Signing Keys
# INSTRUCTIONS: You MUST generate your own 32+ character cryptographically random keys.
# Generate with: openssl rand -hex 32 (or Python: secrets.token_hex(32))
# The application startup validation will strictly reject placeholder values.
SECRET_KEY=REPLACE_WITH_YOUR_OWN_GENERATED_32_CHAR_SECRET_KEY_PLACEHOLDER
CSRF_SECRET_KEY=REPLACE_WITH_YOUR_OWN_GENERATED_32_CHAR_CSRF_KEY_PLACEHOLDER

# Initial Superuser Account (Required for first-time database initialization)
# INSTRUCTIONS: You MUST replace this placeholder with your own strong password.
# The application startup validation will strictly reject this placeholder or any default/common password.
# Minimum 8 characters, combining uppercase, lowercase, numbers, and symbols.
FIRST_SUPERUSER_EMAIL=admin@bankportal.internal
FIRST_SUPERUSER_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD_PLACEHOLDER
FIRST_SUPERUSER_FULL_NAME=System Administrator

# Networking & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Apache Superset Embedded Integration
# Leave blank while unconfigured. Real service credentials are required for live embedding.
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_GUEST_TOKEN_TIMEOUT_SECS=300
