# Application Settings
APP_NAME="Banking Analytics Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS & Frontend URL
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# PostgreSQL Application Database
# NOTE: Dedicated database for portal users and metadata. Do NOT connect to bank_dwh_real.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banking_portal_db

# Security & Session Authentication
# In production, generate with: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CSRF Protection
CSRF_SECRET_KEY=dev-insecure-csrf-secret-key-change-in-production-32c
CSRF_COOKIE_NAME=portal_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Apache Superset Integration
# Real credentials must be configured here before embedding live dashboards
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin_password_placeholder
SUPERSET_GUEST_TOKEN_TIMEOUT_SECS=300

# Initial Admin Seed (optional for first run)
FIRST_SUPERUSER_EMAIL=admin@bankportal.internal
FIRST_SUPERUSER_PASSWORD=ChangeThisPassword123!
FIRST_SUPERUSER_FULL_NAME="Portal Administrator"
