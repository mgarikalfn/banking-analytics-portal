# Application Settings
APP_NAME="Banking Analytics Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS & Frontend URL
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Dedicated PostgreSQL Application Database
# NOTE: Connect to host port 5433 when running Docker PostgreSQL on host, or dedicated port.
# Never point this to bank_dwh_real.
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_YOUR_OWN_SECURE_POSTGRES_PASSWORD_PLACEHOLDER@localhost:5433/banking_portal_db

# Security & Session Authentication
# INSTRUCTIONS: You MUST generate your own 32+ character cryptographically random keys.
# Generate with: openssl rand -hex 32
# The application startup validation will strictly reject placeholder values.
SECRET_KEY=REPLACE_WITH_YOUR_OWN_GENERATED_32_CHAR_SECRET_KEY_PLACEHOLDER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CSRF Protection
CSRF_SECRET_KEY=REPLACE_WITH_YOUR_OWN_GENERATED_32_CHAR_CSRF_KEY_PLACEHOLDER
CSRF_COOKIE_NAME=portal_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Apache Superset Integration
# Leave username and password blank while unconfigured. Real credentials required for live embedding.
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_GUEST_TOKEN_TIMEOUT_SECS=300

# Initial Admin Configuration (Required when initializing a fresh database)
# INSTRUCTIONS: You MUST replace this placeholder with your own strong password.
# The application startup validation will strictly reject this placeholder or any default/common password.
# Minimum 8 characters, combining uppercase, lowercase, numbers, and symbols.
FIRST_SUPERUSER_EMAIL=admin@bankportal.internal
FIRST_SUPERUSER_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD_PLACEHOLDER
FIRST_SUPERUSER_FULL_NAME="Portal Administrator"
