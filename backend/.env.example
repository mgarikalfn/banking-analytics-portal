# Application Settings
APP_NAME="Banking Analytics Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS & Frontend URL
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Dedicated PostgreSQL Application Database
# NOTE: Connect to host port 5433 when running Docker PostgreSQL on host, or dedicated port.
# Never point this to bank_dwh_real.
DATABASE_URL=postgresql+asyncpg://postgres:configure_password@localhost:5433/banking_portal_db

# Security & Session Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=configure_random_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CSRF Protection
CSRF_SECRET_KEY=configure_random_csrf_secret_key_minimum_32_characters_here
CSRF_COOKIE_NAME=portal_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Apache Superset Integration
# Leave username and password blank while unconfigured. Real credentials required for live embedding.
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_GUEST_TOKEN_TIMEOUT_SECS=300

# Initial Admin Configuration (Required when initializing a fresh database)
# Password must be at least 8 characters and cannot be a known default or placeholder.
FIRST_SUPERUSER_EMAIL=admin@bankportal.internal
FIRST_SUPERUSER_PASSWORD=ConfigureAStrongInitialPassword123!
FIRST_SUPERUSER_FULL_NAME="Portal Administrator"
